{
  "name": "archetype-frontend",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "prepare": "husky",
    "format": "prettier --write .",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.js",
    "generate-infra": "tsx scripts/generate-infra.ts",
    "generate-infra:check": "tsx scripts/generate-infra.ts --check",
    "print-env": "tsx scripts/print-env.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "dependency-cruiser": "^16.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.1",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write"
    ]
  }
}
